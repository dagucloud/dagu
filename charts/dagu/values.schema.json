{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "config": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "envPassthrough": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "envPassthroughPrefixes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["none", "basic", "builtin"]
        },
        "proxy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "source": {
              "type": "string",
              "maxLength": 128
            },
            "buttonLabel": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "headers": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "user": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$",
                  "not": {
                    "pattern": "^([Aa][Uu][Tt][Hh][Oo][Rr][Ii][Zz][Aa][Tt][Ii][Oo][Nn]|[Cc][Oo][Oo][Kk][Ii][Ee]|[Hh][Oo][Ss][Tt])$"
                  }
                },
                "groups": {
                  "type": "string",
                  "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]*$",
                  "not": {
                    "pattern": "^([Aa][Uu][Tt][Hh][Oo][Rr][Ii][Zz][Aa][Tt][Ii][Oo][Nn]|[Cc][Oo][Oo][Kk][Ii][Ee]|[Hh][Oo][Ss][Tt])$"
                  }
                }
              },
              "required": ["user", "groups"]
            },
            "autoSignup": {
              "type": "boolean"
            },
            "roleMapping": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "defaultRole": {
                  "type": "string",
                  "enum": ["admin", "manager", "developer", "operator", "viewer"]
                },
                "defaultWorkspaceAccess": {
                  "type": "string",
                  "enum": ["all", "none"]
                },
                "requireMapping": {
                  "type": "boolean",
                  "default": false
                },
                "skipOrgRoleSync": {
                  "type": "boolean",
                  "default": false
                },
                "groupMappings": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string",
                    "enum": ["admin", "manager", "developer", "operator", "viewer"]
                  }
                },
                "workspaceMappings": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "workspace": {
                          "type": "string",
                          "minLength": 1
                        },
                        "role": {
                          "type": "string",
                          "enum": ["manager", "developer", "operator", "viewer"]
                        }
                      },
                      "required": ["workspace", "role"]
                    }
                  }
                }
              },
              "required": [
                "defaultRole",
                "defaultWorkspaceAccess",
                "requireMapping",
                "skipOrgRoleSync",
                "groupMappings",
                "workspaceMappings"
              ]
            }
          },
          "required": [
            "enabled",
            "buttonLabel",
            "headers",
            "autoSignup",
            "roleMapping"
          ]
        },
        "trustedProxy": false,
        "trusted_proxy": false
      }
    },
    "extraEnv": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "name": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "valueFrom": {
            "type": "object"
          }
        },
        "required": [
          "name"
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "auth": {
            "properties": {
              "proxy": {
                "properties": {
                  "enabled": {
                    "const": true
                  }
                },
                "required": ["enabled"]
              }
            },
            "required": ["proxy"]
          }
        },
        "required": ["auth"]
      },
      "then": {
        "properties": {
          "auth": {
            "properties": {
              "mode": {
                "const": "builtin"
              }
            },
            "required": ["mode"]
          },
          "ui": {
            "properties": {
              "replicas": {
                "const": 1
              }
            },
            "required": ["replicas"]
          }
        },
        "required": ["auth", "ui"]
      }
    }
  ]
}
