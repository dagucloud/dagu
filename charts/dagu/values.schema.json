{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "config": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "corsAllowedOrigins": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "envPassthrough": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "envPassthroughPrefixes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": {
          "type": "string",
          "description": "Optional license-key Secret; Dagu also supports license env/file and persisted activation sources.",
          "maxLength": 253,
          "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
        },
        "secretKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[-._a-zA-Z0-9]+$"
        }
      },
      "required": ["existingSecret", "secretKey"]
    },
    "auth": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["none", "basic", "builtin"]
        },
        "oidc": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Enables chart-managed OIDC configuration. Runtime requires an active license from any Dagu-supported source."
            },
            "clientId": {
              "type": "string"
            },
            "clientUrl": {
              "type": "string",
              "anyOf": [
                {
                  "const": ""
                },
                {
                  "format": "uri"
                }
              ]
            },
            "issuer": {
              "type": "string",
              "anyOf": [
                {
                  "const": ""
                },
                {
                  "format": "uri"
                }
              ]
            },
            "scopes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "whitelist": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "format": "email"
              }
            },
            "autoSignup": {
              "type": "boolean"
            },
            "allowedDomains": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "buttonLabel": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "clientSecret": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "existingSecret": {
                  "type": "string",
                  "maxLength": 253,
                  "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
                },
                "secretKey": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 253,
                  "pattern": "^[-._a-zA-Z0-9]+$"
                }
              },
              "required": ["existingSecret", "secretKey"]
            },
            "roleMapping": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "defaultRole": {
                  "type": "string",
                  "enum": ["admin", "manager", "developer", "operator", "viewer"]
                },
                "groupsClaim": {
                  "type": "string",
                  "minLength": 1
                },
                "groupMappings": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string",
                    "enum": ["admin", "manager", "developer", "operator", "viewer"]
                  }
                },
                "workspaceMappings": {
                  "type": "object",
                  "propertyNames": {
                    "pattern": ".*\\S.*"
                  },
                  "additionalProperties": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "workspace": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9_-]+$",
                          "not": {
                            "pattern": "^([Aa][Ll][Ll]|[Dd][Ee][Ff][Aa][Uu][Ll][Tt]|[Gg][Ll][Oo][Bb][Aa][Ll])$"
                          }
                        },
                        "role": {
                          "type": "string",
                          "enum": ["manager", "developer", "operator", "viewer"]
                        }
                      },
                      "required": ["workspace", "role"]
                    }
                  }
                },
                "defaultWorkspaceAccess": {
                  "type": "string",
                  "enum": ["all", "none"]
                },
                "roleAttributePath": {
                  "type": "string"
                },
                "roleAttributeStrict": {
                  "type": "boolean"
                },
                "skipOrgRoleSync": {
                  "type": "boolean"
                }
              },
              "required": [
                "defaultRole",
                "groupsClaim",
                "groupMappings",
                "workspaceMappings",
                "defaultWorkspaceAccess",
                "roleAttributePath",
                "roleAttributeStrict",
                "skipOrgRoleSync"
              ]
            }
          },
          "allOf": [
            {
              "if": {
                "allOf": [
                  {
                    "properties": {
                      "enabled": {
                        "const": true
                      }
                    },
                    "required": ["enabled"]
                  },
                  {
                    "anyOf": [
                      {
                        "properties": {
                          "whitelist": {
                            "minItems": 1
                          }
                        },
                        "required": ["whitelist"]
                      },
                      {
                        "properties": {
                          "allowedDomains": {
                            "minItems": 1
                          }
                        },
                        "required": ["allowedDomains"]
                      }
                    ]
                  }
                ]
              },
              "then": {
                "properties": {
                  "scopes": {
                    "contains": {
                      "const": "email"
                    }
                  }
                },
                "required": ["scopes"]
              }
            }
          ],
          "required": [
            "enabled",
            "clientId",
            "clientUrl",
            "issuer",
            "scopes",
            "whitelist",
            "autoSignup",
            "allowedDomains",
            "buttonLabel",
            "clientSecret",
            "roleMapping"
          ]
        },
        "proxy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "source": {
              "type": "string",
              "maxLength": 128
            },
            "buttonLabel": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "headers": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "user": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$",
                  "not": {
                    "pattern": "^([Aa][Uu][Tt][Hh][Oo][Rr][Ii][Zz][Aa][Tt][Ii][Oo][Nn]|[Cc][Oo][Oo][Kk][Ii][Ee]|[Hh][Oo][Ss][Tt])$"
                  }
                },
                "groups": {
                  "type": "string",
                  "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]*$",
                  "not": {
                    "pattern": "^([Aa][Uu][Tt][Hh][Oo][Rr][Ii][Zz][Aa][Tt][Ii][Oo][Nn]|[Cc][Oo][Oo][Kk][Ii][Ee]|[Hh][Oo][Ss][Tt])$"
                  }
                }
              },
              "required": ["user", "groups"]
            },
            "autoSignup": {
              "type": "boolean"
            },
            "roleMapping": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "defaultRole": {
                  "type": "string",
                  "enum": ["admin", "manager", "developer", "operator", "viewer"]
                },
                "defaultWorkspaceAccess": {
                  "type": "string",
                  "enum": ["all", "none"]
                },
                "requireMapping": {
                  "type": "boolean",
                  "default": false
                },
                "skipOrgRoleSync": {
                  "type": "boolean",
                  "default": false
                },
                "groupMappings": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string",
                    "enum": ["admin", "manager", "developer", "operator", "viewer"]
                  }
                },
                "workspaceMappings": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "workspace": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9_-]+$",
                          "not": {
                            "pattern": "^([Aa][Ll][Ll]|[Dd][Ee][Ff][Aa][Uu][Ll][Tt]|[Gg][Ll][Oo][Bb][Aa][Ll])$"
                          }
                        },
                        "role": {
                          "type": "string",
                          "enum": ["manager", "developer", "operator", "viewer"]
                        }
                      },
                      "required": ["workspace", "role"]
                    }
                  }
                }
              },
              "required": [
                "defaultRole",
                "defaultWorkspaceAccess",
                "requireMapping",
                "skipOrgRoleSync",
                "groupMappings",
                "workspaceMappings"
              ]
            }
          },
          "required": [
            "enabled",
            "buttonLabel",
            "headers",
            "autoSignup",
            "roleMapping"
          ]
        },
        "trustedProxy": false,
        "trusted_proxy": false
      }
    },
    "extraEnv": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "name": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "valueFrom": {
            "type": "object"
          }
        },
        "required": [
          "name"
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "auth": {
            "properties": {
              "oidc": {
                "properties": {
                  "enabled": {
                    "const": true
                  }
                },
                "required": ["enabled"]
              }
            },
            "required": ["oidc"]
          }
        },
        "required": ["auth"]
      },
      "then": {
        "properties": {
          "auth": {
            "properties": {
              "mode": {
                "const": "builtin"
              },
              "oidc": {
                "properties": {
                  "clientId": {
                    "minLength": 1
                  },
                  "clientUrl": {
                    "minLength": 1
                  },
                  "issuer": {
                    "minLength": 1
                  },
                  "clientSecret": {
                    "properties": {
                      "existingSecret": {
                        "minLength": 1
                      }
                    }
                  }
                }
              }
            },
            "required": ["mode", "oidc"]
          }
        },
        "required": ["auth"]
      }
    },
    {
      "if": {
        "properties": {
          "auth": {
            "properties": {
              "proxy": {
                "properties": {
                  "enabled": {
                    "const": true
                  }
                },
                "required": ["enabled"]
              }
            },
            "required": ["proxy"]
          }
        },
        "required": ["auth"]
      },
      "then": {
        "properties": {
          "auth": {
            "properties": {
              "mode": {
                "const": "builtin"
              }
            },
            "required": ["mode"]
          },
          "ui": {
            "properties": {
              "replicas": {
                "const": 1
              }
            },
            "required": ["replicas"]
          }
        },
        "required": ["auth", "ui"]
      }
    }
  ]
}
