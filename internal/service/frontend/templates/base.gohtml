{{define "base"}}
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="{{ basePath }}/assets/favicon.ico" />
    <title>{{ navbarTitle }}</title>
    <script>
      function getConfig() {
        {{- $update := updateStatus }}
        return {
          apiURL: "{{ apiURL }}",
          basePath: "{{ basePath }}",
          title: "{{ navbarTitle }}",
          navbarColor: "{{ navbarColor }}",
          version: "{{ version }}",
          tz: "{{ tz }}",
          tzOffsetInSec: +"{{ tzOffsetInSec }}",
          maxDashboardPageLimit: +"{{ maxDashboardPageLimit }}",
          remoteNodes: "{{ remoteNodes }}",
          initialWorkspaces: (() => { try { return JSON.parse('{{ js initialWorkspacesJSON }}'); } catch { return []; } })(),
          authMode: "{{ authMode }}",
          setupRequired: "{{ setupRequired }}" === "true",
          oidcEnabled: "{{ oidcEnabled }}" === "true",
          oidcButtonLabel: "{{ js oidcButtonLabel }}",
          proxyEnabled: "{{ proxyEnabled }}" === "true",
          proxyButtonLabel: "{{ js proxyButtonLabel }}",
          terminalEnabled: "{{ terminalEnabled }}" === "true",
          gitSyncEnabled: "{{ gitSyncEnabled }}" === "true",
          permissions: {
            writeDags: "{{ permissionsWriteDags }}" === "true",
            runDags: "{{ permissionsRunDags }}" === "true",
          },
          updateAvailable: "{{ $update.UpdateAvailable }}" === "true",
          latestVersion: "{{ js $update.LatestVersion }}",
          upgradeCommand: "{{ js $update.UpgradeCommand }}",
          restartRequired: "{{ $update.RestartRequired }}" === "true",
          restartCommand: "{{ js $update.RestartCommand }}",
          license: {
            valid: "{{ licenseValid }}" === "true",
            plan: "{{ licensePlan }}",
            expiry: "{{ licenseExpiry }}",
            features: (() => { try { return JSON.parse('{{ licenseFeatures }}'); } catch { return []; } })(),
            gracePeriod: "{{ licenseGracePeriod }}" === "true",
            graceEndsAt: "{{ licenseGraceEndsAt }}",
            community: "{{ licenseCommunity }}" === "true",
            source: "{{ licenseSource }}",
            warningCode: "{{ licenseWarningCode }}",
            error: "{{ js licenseError }}",
          },
          paths: {
            dagsDir: "{{ js pathDAGsDir }}",
            logDir: "{{ js pathLogDir }}",
            suspendFlagsDir: "{{ js pathSuspendFlagsDir }}",
            adminLogsDir: "{{ js pathAdminLogsDir }}",
            baseConfig: "{{ js pathBaseConfig }}",
            wikiDir: "{{ js pathWikiDir }}",
            docsDir: "{{ js pathDocsDir }}",
            dagRunsDir: "{{ js pathDAGRunsDir }}",
            queueDir: "{{ js pathQueueDir }}",
            procDir: "{{ js pathProcDir }}",
            serviceRegistryDir: "{{ js pathServiceRegistryDir }}",
            configFileUsed: "{{ js pathConfigFileUsed }}",
            usersDir: "{{ js pathUsersDir }}",
            gitSyncDir: "{{ js pathGitSyncDir }}",
            auditLogsDir: "{{ js pathAuditLogsDir }}",
          },
        };
      }
    </script>
    <script>
      // Apply the saved or system theme before the app loads so the page
      // does not flash the other theme.
      (function () {
        var theme;
        try {
          theme = JSON.parse(localStorage.getItem('user_preferences') || '{}').theme;
        } catch (e) {}
        var dark =
          theme === 'dark' ||
          (theme !== 'light' &&
            !!window.matchMedia &&
            window.matchMedia('(prefers-color-scheme: dark)').matches);
        var root = document.documentElement;
        root.classList.toggle('dark', dark);
        root.style.colorScheme = dark ? 'dark' : 'light';
        root.style.backgroundColor = dark ? '#0b0d12' : '#f4f2ed';
      })();
    </script>
    <script
      defer="defer"
      src="{{ basePath }}/assets/bundle.js?v={{ assetVersion }}"
    ></script>
  </head>
  <body>
    {{template "content" .}}
  </body>
</html>
{{ end }}
